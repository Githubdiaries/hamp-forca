# Copy to .env and fill in values
POSTGRES_USER=hamper
POSTGRES_PASSWORD=hamper_secret
POSTGRES_DB=hamper_forecast
DATABASE_URL=postgresql://hamper:hamper_secret@postgres:5432/hamper_forecast

# Rotate if exposed; never commit .env
FIRECRAWL_API_KEY=fc-your-api-key-here

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

MODEL_DIR=/models
FORECAST_HORIZON=6
LSTM_WINDOW=12
TRAIN_EPOCHS=2
MIN_TRAINING_ROWS=18
